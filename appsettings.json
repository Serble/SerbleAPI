{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3307;Database=serbleapi;User=root;Password=admin;"
  },
  "Api": {
    "BindUrl": "http://*:5000",
    "WebsiteUrl": "https://localhost:7244",
    "LiveUrl": "http://localhost:5000/",
    "Redirects": {
      "discord": "https://discord.gg/fzvcNhW"
    }
  },
  "Oidc": {
    "Issuer": "http://localhost:5000/",
    "AuthorizationCodeLifetimeSeconds": 300,
    "AccessTokenLifetimeSeconds": 3600,
    "IdTokenLifetimeSeconds": 900,
    "RefreshTokenLifetimeDays": 30,
    "RequirePkceForPublicClients": true,
    "SigningKeys": []
  },
  "Stripe": {
    "ApiKey": "somestripeapikey",
    "WebhookSecret": "somestripesecret",
    "PremiumSubscriptionId": "somepriceid"
  },
  "Passkey": {
    "RelyingPartyId": "localhost",
    "RelyingPartyName": "Serble",
    "AllowedOrigins": [
      "https://serble.net",
      "https://www.serble.net",
      "https://serble",
      "http://localhost:5173"
    ]
  },
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 465,
    "Security": "auto",
    "TimeoutSeconds": 30,
    "SmtpUsername": "somesmtpusername",
    "SmtpPassword": "somesmtppassword",
    "Addresses": {
      "System": "system@serble.net",
      "Newsletter": "newsletter@serble.net",
      "Contact": "admin@serble.net"
    }
  },
  "Jwt": {
    "Issuer": "CoPokBl",
    "Audience": "Privileged Users",
    "Secret": "somejwtsecretkey"
  },
  "Turnstile": {
    "SecretKey": "somecaptchasecretkey"
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "TrustAllProxies": false,
    "ForwardedForHeaderName": "X-Forwarded-For",
    "ForwardedProtoHeaderName": "X-Forwarded-Proto",
    "ForwardedHostHeaderName": "X-Forwarded-Host",
    "RequireHeaderSymmetry": false,
    "AllowedHosts": []
  },
  "RateLimit": {
    "Enabled": true,
    "MaxTrackedPartitions": 200000,
    "Tiers": {
      "auth": {
        "Enabled": true,
        "PerIp": {
          "Enabled": true,
          "PermitLimit": 20,
          "WindowSeconds": 60
        },
        "PerIdentity": {
          "Enabled": true,
          "PermitLimit": 5,
          "WindowSeconds": 60
        },
        "Backoff": {
          "Enabled": true,
          "BaseSeconds": 60,
          "Multiplier": 4,
          "MaxSeconds": 3600,
          "DecaySeconds": 3600
        }
      },
      "costly": {
        "Enabled": true,
        "PerIp": {
          "Enabled": true,
          "PermitLimit": 15,
          "WindowSeconds": 60
        },
        "PerIdentity": {
          "Enabled": true,
          "PermitLimit": 10,
          "WindowSeconds": 60
        },
        "Backoff": {
          "Enabled": true,
          "BaseSeconds": 60,
          "Multiplier": 2,
          "MaxSeconds": 1800,
          "DecaySeconds": 1800
        }
      },
      "write": {
        "Enabled": true,
        "PerIp": {
          "Enabled": true,
          "PermitLimit": 90,
          "WindowSeconds": 60
        },
        "PerIdentity": {
          "Enabled": true,
          "PermitLimit": 60,
          "WindowSeconds": 60
        },
        "Backoff": {
          "Enabled": true,
          "BaseSeconds": 15,
          "Multiplier": 2,
          "MaxSeconds": 900,
          "DecaySeconds": 900
        }
      },
      "read": {
        "Enabled": true,
        "PerIp": {
          "Enabled": true,
          "PermitLimit": 300,
          "WindowSeconds": 60
        },
        "PerIdentity": {
          "Enabled": true,
          "PermitLimit": 300,
          "WindowSeconds": 60
        },
        "Backoff": {
          "Enabled": true,
          "BaseSeconds": 10,
          "Multiplier": 2,
          "MaxSeconds": 300,
          "DecaySeconds": 300
        }
      }
    }
  }
}
